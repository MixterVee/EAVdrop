<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EAVdrop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:EAVdrop.Pages"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{DynamicResource EavShellBackground}"
    Shell.ForegroundColor="{DynamicResource EavText}"
    Shell.TitleColor="{DynamicResource EavText}"
    Shell.TabBarBackgroundColor="{DynamicResource EavTabBarBackground}"
    Shell.TabBarForegroundColor="{StaticResource EavAccent}"
    Shell.TabBarTitleColor="{StaticResource EavAccent}"
    Shell.TabBarUnselectedColor="{DynamicResource EavTabUnselected}">

    <TabBar>
        <ShellContent Title="Dashboard" Route="dashboard" ContentTemplate="{DataTemplate pages:DashboardPage}" />
        <ShellContent Title="Activity" Route="activity" ContentTemplate="{DataTemplate pages:ActivityPage}" />
        <ShellContent Title="Users" Route="users" ContentTemplate="{DataTemplate pages:UsersPage}" />
        <ShellContent Title="Devices" Route="devices" ContentTemplate="{DataTemplate pages:DeviceStatusPage}" />
        <ShellContent Title="Sync'EM" Route="sync" ContentTemplate="{DataTemplate pages:SyncPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>
</Shell>
