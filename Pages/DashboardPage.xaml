<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Now Playing">

    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Now Playing" FontSize="28" FontAttributes="Bold" />
                <Label x:Name="ConnectionLabel" Text="Not connected" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Refresh" Clicked="RefreshClicked" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />
            <Label x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource MutedLabel}" VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Label x:Name="EmptyLabel"
                   Text="No one is currently playing anything."
                   Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="False" />

            <CollectionView x:Name="SessionsView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding UserDisplay}" FontSize="21" FontAttributes="Bold" />
                                    <Border Grid.Column="1" StrokeThickness="1" Stroke="{StaticResource EavAccent}" Padding="8,3">
                                        <Label Text="{Binding PlaybackMethod}" TextColor="{StaticResource EavAccent}" FontAttributes="Bold" FontSize="12" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding MediaDisplay}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding DeviceDisplay}" Style="{StaticResource MutedLabel}" />

                                <FlexLayout Direction="Row"
                                            Wrap="Wrap"
                                            JustifyContent="Start"
                                            AlignItems="Start"
                                            BindableLayout.ItemsSource="{Binding QualityBadges}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Stroke="{StaticResource EavAccent}"
                                                    StrokeThickness="1"
                                                    Padding="7,3"
                                                    Margin="0,0,6,4">
                                                <Label Text="{Binding .}"
                                                       TextColor="{StaticResource EavAccent}"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource EavAccent}" HeightRequest="8" />
                                <Label Text="{Binding ProgressText}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" />
                                <BoxView HeightRequest="1" Opacity="0.2" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="Stream" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding StreamDetails}" Style="{StaticResource MutedLabel}" />
                                </Grid>
                                <Label Text="{Binding EndpointDisplay}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
