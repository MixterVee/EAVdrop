<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout
            Padding="{OnIdiom Phone='12', Default='18'}"
            Spacing="{OnIdiom Phone=10, Default=14}">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Dashboard"
                           FontSize="{OnIdiom Phone=26, Default=28}"
                           FontAttributes="Bold" />
                    <Label x:Name="ConnectionLabel"
                           Text="Not connected"
                           Style="{StaticResource MutedLabel}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Refresh"
                        Clicked="RefreshClicked"
                        VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ActivityIndicator x:Name="BusyIndicator"
                                   IsVisible="False"
                                   IsRunning="False" />
                <Label x:Name="StatusLabel"
                       Grid.Column="1"
                       Style="{StaticResource MutedLabel}"
                       VerticalTextAlignment="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="{OnIdiom Phone=8, Default=12}"
                  RowSpacing="{OnIdiom Phone=8, Default=12}">

                <Border Style="{StaticResource CardBorder}"
                        Margin="0"
                        Padding="{OnIdiom Phone='12', Default='16'}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Now Playing"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12"
                               FontAttributes="Bold" />
                        <Label x:Name="ActiveStreamsValue"
                               Text="0"
                               FontSize="{OnIdiom Phone=28, Default=34}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource EavAccent}" />
                        <Label x:Name="ActiveStreamsDetail"
                               Text="active streams"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardBorder}"
                        Margin="0"
                        Padding="{OnIdiom Phone='12', Default='16'}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Active Users"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12"
                               FontAttributes="Bold" />
                        <Label x:Name="ActiveUsersValue"
                               Text="0"
                               FontSize="{OnIdiom Phone=28, Default=34}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource EavAccent}" />
                        <Label Text="playing now"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource CardBorder}"
                        Margin="0"
                        Padding="{OnIdiom Phone='12', Default='16'}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Devices"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12"
                               FontAttributes="Bold" />
                        <Label x:Name="DeviceSessionsValue"
                               Text="0"
                               FontSize="{OnIdiom Phone=28, Default=34}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource EavAccent}" />
                        <Label x:Name="DeviceSessionsDetail"
                               Text="sessions visible"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CardBorder}"
                        Margin="0"
                        Padding="{OnIdiom Phone='12', Default='16'}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Transcoding"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12"
                               FontAttributes="Bold" />
                        <Label x:Name="TranscodingValue"
                               Text="0"
                               FontSize="{OnIdiom Phone=28, Default=34}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource EavAccent}" />
                        <Label x:Name="TranscodingDetail"
                               Text="active transcodes"
                               Style="{StaticResource MutedLabel}"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0">
                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="3">
                    <Label Text="Server"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Label x:Name="ServerNameLabel"
                           Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="Not connected"
                           FontAttributes="Bold" />

                    <Label x:Name="ServerDetailLabel"
                           Grid.Row="2"
                           Style="{StaticResource MutedLabel}"
                           LineBreakMode="TailTruncation" />

                    <Label x:Name="ConnectionModeLabel"
                           Grid.Row="2"
                           Grid.Column="1"
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="End" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Sync'EM"
                               FontSize="18"
                               FontAttributes="Bold" />
                        <Label x:Name="SyncStatusLabel"
                               Text="Not syncing"
                               Style="{StaticResource MutedLabel}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Open Sync'EM"
                            Clicked="OpenSyncClicked"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="Events"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label x:Name="EventsCaption"
                           Text="Watching playback, transcoding, users and Sync'EM"
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1"
                                       Spacing="6"
                                       VerticalOptions="Center">
                    <Button x:Name="ShowAllEventsButton"
                            Text="All"
                            Clicked="ToggleEventsClicked"
                            Padding="10,8"
                            IsVisible="False" />
                    <Button Text="Clear"
                            Clicked="ClearEventsClicked"
                            Padding="10,8" />
                </HorizontalStackLayout>
            </Grid>

            <Label x:Name="EventsEmptyLabel"
                   Text="No events yet. EAVdrop is watching for changes."
                   Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,12"
                   IsVisible="True" />

            <VerticalStackLayout x:Name="EventsStack"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MediaCardBorder}">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="4,*,Auto"
                                  RowSpacing="4"
                                  ColumnSpacing="10">
                                <BoxView Grid.RowSpan="2"
                                         BackgroundColor="{StaticResource EavAccent}" />

                                <Label Grid.Column="1"
                                       Text="{Binding KindDisplay}"
                                       Style="{StaticResource MediaEyebrowLabel}" />

                                <Label Grid.Column="2"
                                       Text="{Binding TimeDisplay}"
                                       Style="{StaticResource MediaMetaLabel}"
                                       VerticalTextAlignment="Center" />

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="1"
                                                     Grid.ColumnSpan="2"
                                                     Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding DetailLine}"
                                           Style="{StaticResource MediaMetaLabel}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="Now Playing"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label x:Name="NowPlayingCaption"
                           Text="Live Emby sessions"
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Devices"
                        Clicked="OpenDevicesClicked"
                        VerticalOptions="Center"
                        Padding="12,8" />
            </Grid>

            <Label x:Name="EmptyLabel"
                   Text="No one is currently playing anything."
                   Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,18"
                   IsVisible="False" />

            <VerticalStackLayout x:Name="SessionsStack"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding UserDisplay}"
                                           FontSize="20"
                                           FontAttributes="Bold" />
                                    <Border Grid.Column="1"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource EavAccent}"
                                            Padding="8,3">
                                        <Label Text="{Binding PlaybackMethod}"
                                               TextColor="{StaticResource EavAccent}"
                                               FontAttributes="Bold"
                                               FontSize="12" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding MediaDisplay}"
                                       FontSize="17"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding DeviceDisplay}"
                                       Style="{StaticResource MutedLabel}" />

                                <FlexLayout Direction="Row"
                                            Wrap="Wrap"
                                            JustifyContent="Start"
                                            AlignItems="Start"
                                            BindableLayout.ItemsSource="{Binding QualityBadges}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border Stroke="{StaticResource EavAccent}"
                                                    StrokeThickness="1"
                                                    Padding="7,3"
                                                    Margin="0,0,6,4">
                                                <Label Text="{Binding .}"
                                                       TextColor="{StaticResource EavAccent}"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <ProgressBar Progress="{Binding Progress}"
                                             ProgressColor="{StaticResource EavAccent}"
                                             HeightRequest="7" />
                                <Label Text="{Binding ProgressText}"
                                       Style="{StaticResource MutedLabel}"
                                       HorizontalTextAlignment="End" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="Stream" FontAttributes="Bold" />
                                    <Label Grid.Column="1"
                                           Text="{Binding StreamDetails}"
                                           Style="{StaticResource MutedLabel}" />
                                </Grid>

                                <Label Text="{Binding EndpointDisplay}"
                                       Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  Margin="0,4,0,0">
                <VerticalStackLayout Spacing="1">
                    <Label Text="Recent Activity"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label x:Name="RecentActivityCaption"
                           Text="Latest completed playback"
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Activity"
                        Clicked="OpenActivityClicked"
                        VerticalOptions="Center"
                        Padding="12,8" />
            </Grid>

            <Label x:Name="RecentEmptyLabel"
                   Text="No recent playback activity found."
                   Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,14"
                   IsVisible="False" />

            <VerticalStackLayout x:Name="RecentActivityStack"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MediaCardBorder}">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="4,*,Auto"
                                  RowSpacing="4"
                                  ColumnSpacing="10">
                                <BoxView Grid.RowSpan="2"
                                         BackgroundColor="{StaticResource EavAccent}" />

                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Column="2"
                                       Text="{Binding DateDisplay}"
                                       Style="{StaticResource MediaMetaLabel}"
                                       VerticalTextAlignment="Center" />

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding DetailLine}"
                                       Style="{StaticResource MediaMetaLabel}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
