<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard">

    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="EAVdrop" FontSize="28" FontAttributes="Bold" />
                <Label x:Name="ConnectionLabel" Text="Not connected" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Refresh" Clicked="RefreshClicked" VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />
            <Label x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource MutedLabel}" VerticalTextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Label x:Name="EmptyLabel"
                   Text="No one is currently playing anything."
                   Style="{StaticResource MutedLabel}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="False" />

            <CollectionView x:Name="SessionsView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding UserDisplay}" FontSize="20" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding PlaybackMethod}" TextColor="{StaticResource EavAccent}" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="{Binding MediaDisplay}" FontSize="17" />
                                <Label Text="{Binding DeviceDisplay}" Style="{StaticResource MutedLabel}" />
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource EavAccent}" HeightRequest="6" />
                                <Label Text="{Binding ProgressText}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
