<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14" MaximumWidthRequest="760" HorizontalOptions="Fill">
            <Label Text="Settings" FontSize="28" FontAttributes="Bold" />
            <Label Text="Sign in with an Emby administrator account. Your password is used only during sign-in and is never saved." Style="{StaticResource MutedLabel}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Connection" FontSize="20" FontAttributes="Bold" />

                    <Label Text="Local Emby URL" FontAttributes="Bold" />
                    <Entry x:Name="LocalUrlEntry" Placeholder="http://192.168.1.188:19096" Keyboard="Url" />

                    <Label Text="Remote HTTPS URL" FontAttributes="Bold" />
                    <Entry x:Name="RemoteUrlEntry" Placeholder="https://emby.example.com" Keyboard="Url" />

                    <Label Text="Connection mode" FontAttributes="Bold" />
                    <Picker x:Name="ModePicker" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Emby account" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="SignedInLabel" Text="Not signed in" Style="{StaticResource MutedLabel}" />

                    <Label Text="Username" FontAttributes="Bold" />
                    <Entry x:Name="UsernameEntry" Placeholder="Emby username" ReturnType="Next" />

                    <Label Text="Password" FontAttributes="Bold" />
                    <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Emby password" ReturnType="Done" Completed="PasswordCompleted" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Sign In" Clicked="SignInClicked" />
                        <Button Text="Sign Out" Clicked="SignOutClicked" />
                    </HorizontalStackLayout>

                    <Label Text="For remote sign-in, use HTTPS. EAVdrop stores the returned Emby access token securely, not your password." Style="{StaticResource MutedLabel}" />
                    <Label x:Name="AccountStatusLabel" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Playback history" FontSize="20" FontAttributes="Bold" />
                    <Label Text="How far back should Activity and Users look?" Style="{StaticResource MutedLabel}" />
                    <Picker x:Name="HistoryRangePicker" Title="Playback history range" />
                    <Label Text="Unlimited shows all playback history available through Emby and may take longer on large libraries." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Save Settings" Clicked="SaveClicked" />
                <Button Text="Test Connection" Clicked="TestClicked" />
            </HorizontalStackLayout>

            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />
            <Label x:Name="StatusLabel" Style="{StaticResource MutedLabel}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Playback Reporting" FontSize="18" FontAttributes="Bold" />
                    <Label Text="Playback Reporting is installed on the server. EAVdrop currently uses Emby's standard per-user playback data; deeper event-level reporting can be added next." Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
