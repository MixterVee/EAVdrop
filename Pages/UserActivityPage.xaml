<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.UserActivityPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="User Activity">

    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="UserTitle"
                       Text="User"
                       FontSize="28"
                       FontAttributes="Bold" />
                <Label x:Name="HistoryRangeLabel"
                       Text="Playback history"
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Refresh"
                    Clicked="RefreshClicked"
                    VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource MediaCardBorder}">
            <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                <BoxView BackgroundColor="{StaticResource EavAccent}" />
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label x:Name="SummaryTitleLabel"
                           Text="Last Played"
                           Style="{StaticResource MediaEyebrowLabel}" />
                    <Label x:Name="SummaryMainLabel"
                           Text="Loading…"
                           Style="{StaticResource MediaTitleLabel}" />
                    <Label x:Name="SummaryDetailLabel"
                           Style="{StaticResource MediaMetaLabel}"
                           LineBreakMode="WordWrap" />
                    <ProgressBar x:Name="NowPlayingProgressBar"
                                 IsVisible="False"
                                 HeightRequest="5" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Label x:Name="StatusLabel"
                   Style="{StaticResource MutedLabel}"
                   VerticalTextAlignment="Center" />
            <Label Grid.Column="1"
                   Text="Newest first"
                   Style="{StaticResource MutedLabel}"
                   VerticalTextAlignment="Center" />
        </Grid>

        <CollectionView Grid.Row="3"
                        x:Name="ActivityView"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No playback in the selected history range."
                       Style="{StaticResource MutedLabel}"
                       HorizontalOptions="Center"
                       Margin="0,40" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MediaCardBorder}">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              ColumnDefinitions="4,*,Auto"
                              RowSpacing="4"
                              ColumnSpacing="10">
                            <BoxView Grid.RowSpan="3"
                                     BackgroundColor="{StaticResource EavAccent}" />
                            <Label Grid.Column="1"
                                   Text="{Binding TypeDisplay}"
                                   Style="{StaticResource MediaEyebrowLabel}" />
                            <Label Grid.Column="2"
                                   Text="{Binding DateDisplay}"
                                   Style="{StaticResource MediaMetaLabel}"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding Title}"
                                   Style="{StaticResource MediaTitleLabel}" />
                            <Label Grid.Row="2"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="Playback history"
                                   Style="{StaticResource MediaMetaLabel}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
