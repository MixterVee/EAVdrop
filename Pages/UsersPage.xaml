<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.UsersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Users">

    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Users" FontSize="28" FontAttributes="Bold" />
                <Label x:Name="RangeCaptionLabel"
                       Text="Recent playback"
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Refresh"
                    Clicked="RefreshClicked"
                    VerticalOptions="Center" />
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button x:Name="FavoritesOnlyButton"
                    Text="☆ Favorites only"
                    Clicked="FavoritesOnlyClicked"
                    Padding="14,8"
                    FontSize="13" />
            <Label Text="Tap ☆ beside a user to pin them to the top."
                   Style="{StaticResource MutedLabel}"
                   VerticalTextAlignment="Center" />
        </HorizontalStackLayout>

        <Label Grid.Row="2"
               x:Name="StatusLabel"
               Style="{StaticResource MutedLabel}" />

        <CollectionView Grid.Row="3"
                        x:Name="UsersView"
                        SelectionMode="Single"
                        SelectionChanged="UserSelected">
            <CollectionView.EmptyView>
                <Label x:Name="EmptyLabel"
                       Text="No Emby users to show."
                       Style="{StaticResource MutedLabel}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,40" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto,Auto"
                              RowSpacing="7"
                              ColumnSpacing="8">

                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />

                            <Button Grid.Column="1"
                                    Text="{Binding FavoriteGlyph}"
                                    CommandParameter="{Binding .}"
                                    Clicked="FavoriteClicked"
                                    FontSize="20"
                                    Padding="0"
                                    WidthRequest="42"
                                    HeightRequest="38"
                                    ToolTipProperties.Text="Add or remove favorite" />

                            <Label Grid.Column="2"
                                   Text="View ›"
                                   TextColor="{StaticResource EavAccent}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Style="{StaticResource MediaCardBorder}"
                                    IsVisible="{Binding IsNowPlaying}"
                                    Margin="0,2,0,2">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="4,*"
                                      RowSpacing="4"
                                      ColumnSpacing="10">
                                    <BoxView Grid.RowSpan="4"
                                             BackgroundColor="{StaticResource EavAccent}" />
                                    <Label Grid.Column="1"
                                           Text="NOW PLAYING"
                                           Style="{StaticResource MediaEyebrowLabel}" />
                                    <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding NowPlayingTitle}"
                                           Style="{StaticResource MediaTitleLabel}" />
                                    <Label Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding NowPlayingDetail}"
                                           Style="{StaticResource MediaMetaLabel}" />
                                    <ProgressBar Grid.Row="3"
                                                 Grid.Column="1"
                                                 Progress="{Binding NowPlayingProgress}"
                                                 HeightRequest="5" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Row="2"
                                                 Grid.ColumnSpan="3"
                                                 Spacing="3">
                                <Label Text="{Binding RecentHeading}"
                                       FontAttributes="Bold"
                                       FontSize="13" />
                                <Label Text="{Binding RecentLine1}"
                                       IsVisible="{Binding HasRecentLine1}"
                                       Style="{StaticResource MutedLabel}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding RecentLine2}"
                                       IsVisible="{Binding HasRecentLine2}"
                                       Style="{StaticResource MutedLabel}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding RecentLine3}"
                                       IsVisible="{Binding HasRecentLine3}"
                                       Style="{StaticResource MutedLabel}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Label Grid.Row="3"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding ActivityCountText}"
                                   Style="{StaticResource MutedLabel}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
