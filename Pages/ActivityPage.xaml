<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Activity">

    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Activity" FontSize="28" FontAttributes="Bold" />
                <Label x:Name="RangeCaptionLabel" Text="Playback history" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Refresh" Clicked="RefreshClicked" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Picker x:Name="UserPicker" Title="All users" SelectedIndexChanged="FilterChanged" />
            <SearchBar Grid.Column="1" x:Name="SearchBox" Placeholder="Search playback" TextChanged="SearchChanged" />
        </Grid>

        <Label Grid.Row="2" x:Name="StatusLabel" Style="{StaticResource MutedLabel}" />

        <CollectionView Grid.Row="3" x:Name="ActivityView" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No playback in the selected history range." Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" />
                                <Label Grid.Column="1" Text="{Binding DateDisplay}" Style="{StaticResource MutedLabel}" />
                            </Grid>
                            <Label Text="{Binding UserName}" TextColor="{StaticResource EavAccent}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
