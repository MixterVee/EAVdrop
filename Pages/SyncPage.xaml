<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sync'EM up">

    <Grid Padding="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Sync'EM up" FontSize="28" FontAttributes="Bold" />
                <Label Text="Watch together, stay together." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Refresh"
                    Clicked="RefreshClicked"
                    VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="10">
                <Label Text="1. Choose the host" FontSize="19" FontAttributes="Bold" />
                <Label Text="Start the movie or episode normally on one Emby device, then select that active session here."
                       Style="{StaticResource MutedLabel}" />
                <Picker x:Name="HostPicker"
                        Title="Choose currently playing host"
                        SelectedIndexChanged="HostChanged" />
                <Label x:Name="HostMediaLabel"
                       Text="No host selected"
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView x:Name="ParticipantsView"
                        Grid.Row="2"
                        SelectionMode="Multiple"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="2. Choose participant devices" FontSize="19" FontAttributes="Bold" />
                        <Label Text="Select one or more other Emby sessions. Devices reported as controllable are preferred, but Sync'EM up will also let us test an idle session that Emby still reports."
                               Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Emby is not reporting any other session. Open Emby on the second device, interact with it once, then press Refresh."
                       Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding DeviceDisplay}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding UserDisplay}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding MediaDisplay}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding SyncControlStatus}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding LastActivityDisplay}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="SELECT"
                                   TextColor="{StaticResource EavAccent}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="StatusLabel"
                       Text="Not syncing"
                       LineBreakMode="WordWrap" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="Participant lead"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center" />
                    <Picker x:Name="ParticipantLeadPicker"
                            Grid.Column="1"
                            Title="Timing offset"
                            SelectedIndexChanged="ParticipantLeadChanged"
                            HorizontalOptions="Fill" />
                </Grid>

                <Label x:Name="LeadCaptionLabel"
                       Text="Participant playback is cued 500 ms ahead of the host."
                       Style="{StaticResource MutedLabel}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="StartButton"
                            Text="Start Together"
                            Clicked="StartClicked"
                            HorizontalOptions="Fill" />
                    <Button x:Name="StopButton"
                            Grid.Column="1"
                            Text="Stop Sync"
                            Clicked="StopClicked"
                            IsEnabled="False"
                            HorizontalOptions="Fill" />
                </Grid>

                <Label Text="The device list scrolls independently, so Start Together and timing adjustment stay visible."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
