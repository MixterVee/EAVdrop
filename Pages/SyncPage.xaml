<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sync'EM up">

    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Sync'EM up" FontSize="28" FontAttributes="Bold" />
                <Label Text="Pick devices, pick something to watch, and start together."
                       Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Refresh"
                    Clicked="RefreshClicked"
                    VerticalOptions="Center" />
        </Grid>

        <CollectionView x:Name="ParticipantsView"
                        Grid.Row="1"
                        SelectionMode="Multiple"
                        SelectionChanged="ParticipantsChanged"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="1. Host device" FontSize="19" FontAttributes="Bold" />
                            <Picker x:Name="HostPicker"
                                    Title="Choose host device"
                                    MinimumHeightRequest="56"
                                    HorizontalOptions="Fill"
                                    SelectedIndexChanged="HostChanged" />
                            <Label x:Name="HostMediaLabel"
                                   Text="No host selected"
                                   Style="{StaticResource MutedLabel}" />
                            <Label x:Name="RememberedSetupLabel"
                                   Text="Your last working device setup will be restored automatically."
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="2. What do you want to watch?" FontSize="19" FontAttributes="Bold" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Continue Watching"
                                        Clicked="ContinueWatchingClicked"
                                        HorizontalOptions="Fill" />
                                <Button Grid.Column="1"
                                        Text="Recently Played"
                                        Clicked="RecentlyPlayedClicked"
                                        HorizontalOptions="Fill" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry x:Name="MediaSearchEntry"
                                       Placeholder="Search movies or episodes"
                                       Completed="MediaSearchCompleted"
                                       ReturnType="Search" />
                                <Button x:Name="MediaSearchButton"
                                        Grid.Column="1"
                                        Text="Search"
                                        Clicked="MediaSearchClicked" />
                            </Grid>

                            <Picker x:Name="MediaPicker"
                                    Title="Choose a movie or episode"
                                    SelectedIndexChanged="MediaChanged" />
                            <Label x:Name="MediaSearchStatusLabel"
                                   Text="Choose Continue Watching, Recently Played, or search."
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="3. Participant devices" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Select one or more other Emby devices."
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="No other Emby sessions are visible. Open Emby on the other device, interact with it once, then press Refresh."
                       Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding DeviceDisplay}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding UserDisplay}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding MediaDisplay}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding SyncControlStatus}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="SELECT"
                                   TextColor="{StaticResource EavAccent}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
    <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="ReadyLabel"
                           Text="Choose a host and participant."
                           FontAttributes="Bold"
                           LineBreakMode="WordWrap" />
    
                    <Label x:Name="StatusLabel"
                           Text="Not syncing"
                           Style="{StaticResource MutedLabel}"
                           LineBreakMode="WordWrap" />
    
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="Lead"
                               VerticalTextAlignment="Center"
                               FontAttributes="Bold" />
                        <Picker x:Name="ParticipantLeadPicker"
                                Grid.Column="1"
                                Title="Timing offset"
                                SelectedIndexChanged="ParticipantLeadChanged"
                                HorizontalOptions="Fill" />
                        <Button x:Name="RealignButton"
                                Grid.Column="2"
                                Text="Precision Re-align"
                                Clicked="RealignClicked"
                                IsEnabled="False" />
                    </Grid>
    
                    <Button x:Name="StartFromBeginningButton"
                            Text="Start Together from Beginning"
                            Clicked="StartFromBeginningClicked"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill" />
    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="StartButton"
                                Text="Join Current Playback"
                                Clicked="StartClicked"
                                HorizontalOptions="Fill" />
                        <Button x:Name="StopButton"
                                Grid.Column="1"
                                Text="Stop Sync"
                                Clicked="StopClicked"
                                IsEnabled="False"
                                HorizontalOptions="Fill" />
                    </Grid>
    
                    <Label Text="Preferred: start from the beginning. EAVdrop preloads both players, applies your saved lead, then releases them together."
                           Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
