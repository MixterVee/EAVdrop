<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="EAVdrop.Pages.SyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sync'EM up">

    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Sync'EM up" FontSize="28" FontAttributes="Bold" />
                <Label Text="Watch together, stay together." Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Refresh"
                    Clicked="RefreshClicked"
                    VerticalOptions="Center" />
        </Grid>

        <CollectionView x:Name="ParticipantsView"
                        Grid.Row="1"
                        SelectionMode="Multiple"
                        VerticalOptions="Fill">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="1. Choose the host device" FontSize="19" FontAttributes="Bold" />
                            <Label Text="For Start from Beginning the host can be idle. Join Current Playback requires the host to already be playing."
                                   Style="{StaticResource MutedLabel}" />
                            <Picker x:Name="HostPicker"
                                    Title="Choose host device"
                                    SelectedIndexChanged="HostChanged" />
                            <Label x:Name="HostMediaLabel"
                                   Text="No host selected"
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="2. Choose media for Start from Beginning" FontSize="19" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Entry x:Name="MediaSearchEntry"
                                       Placeholder="Search movies or episodes"
                                       Completed="MediaSearchCompleted"
                                       ReturnType="Search" />
                                <Button x:Name="MediaSearchButton"
                                        Grid.Column="1"
                                        Text="Search"
                                        Clicked="MediaSearchClicked" />
                            </Grid>
                            <Picker x:Name="MediaPicker"
                                    Title="Search, then choose a movie or episode"
                                    SelectedIndexChanged="MediaChanged" />
                            <Label x:Name="MediaSearchStatusLabel"
                                   Text="Not needed when joining current playback."
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="3. Choose participant devices" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Select one or more other Emby sessions."
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Emby is not reporting any other session. Open Emby on the second device, interact with it once, then press Refresh."
                       Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding DeviceDisplay}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding UserDisplay}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding MediaDisplay}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding SyncControlStatus}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding LastActivityDisplay}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="SELECT"
                                   TextColor="{StaticResource EavAccent}"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="StatusLabel"
                       Text="Not syncing"
                       LineBreakMode="WordWrap" />

                <Label Text="Participant lead"
                       FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Picker x:Name="ParticipantLeadPicker"
                            Title="Timing offset"
                            SelectedIndexChanged="ParticipantLeadChanged"
                            HorizontalOptions="Fill" />
                    <Button x:Name="RealignButton"
                            Grid.Column="1"
                            Text="Precision Re-align"
                            Clicked="RealignClicked"
                            IsEnabled="False" />
                </Grid>

                <Label Text="Start from Beginning preloads both players, locks host at 0 ms and participant at the selected lead, then releases them together. Seeks and pauses continue to use Precision Re-align."
                       Style="{StaticResource MutedLabel}" />

                <Button x:Name="StartFromBeginningButton"
                        Text="Start from Beginning"
                        Clicked="StartFromBeginningClicked"
                        HorizontalOptions="Fill" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button x:Name="StartButton"
                            Text="Join Current Playback"
                            Clicked="StartClicked"
                            HorizontalOptions="Fill" />
                    <Button x:Name="StopButton"
                            Grid.Column="1"
                            Text="Stop Sync"
                            Clicked="StopClicked"
                            IsEnabled="False"
                            HorizontalOptions="Fill" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
